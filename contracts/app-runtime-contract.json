{
  "extensionId": "app.stockSub.runtime",
  "events": {
    "runtimeProfileRequest": "app:runtime-profile:request",
    "runtimeProfileResponse": "app:runtime-profile:response",
    "appError": "app:error",
    "watchlistListRequest": "watchlist:list:request",
    "watchlistListResponse": "watchlist:list:response",
    "watchlistCreateRequest": "watchlist:create:request",
    "watchlistCreateResponse": "watchlist:create:response",
    "watchlistUpdateRequest": "watchlist:update:request",
    "watchlistUpdateResponse": "watchlist:update:response",
    "watchlistHideRequest": "watchlist:hide:request",
    "watchlistHideResponse": "watchlist:hide:response",
    "watchlistArchiveRequest": "watchlist:archive:request",
    "watchlistArchiveResponse": "watchlist:archive:response",
    "watchlistRestoreRequest": "watchlist:restore:request",
    "watchlistRestoreResponse": "watchlist:restore:response",
    "watchlistDeleteRequest": "watchlist:delete:request",
    "watchlistDeleteResponse": "watchlist:delete:response",
    "watchlistReorderRequest": "watchlist:reorder:request",
    "watchlistReorderResponse": "watchlist:reorder:response",
    "tossCredentialsReadStatusRequest": "settings:toss-credentials:read-status",
    "tossCredentialsReadStatusResponse": "settings:toss-credentials:read-status:response",
    "tossCredentialsSaveRequest": "settings:toss-credentials:save",
    "tossCredentialsSaveResponse": "settings:toss-credentials:save:response",
    "tossCredentialsDeleteRequest": "settings:toss-credentials:delete",
    "tossCredentialsDeleteResponse": "settings:toss-credentials:delete:response",
    "tossConnectionTestRequest": "settings:toss-connection:test",
    "tossConnectionTestResponse": "settings:toss-connection:test:response"
  },
  "capabilities": ["watchlist", "quantIndicators", "llmInsights", "orders"],
  "errorCodes": [
    "invalid_request",
    "runtime_profile_unavailable",
    "extension_unavailable",
    "storage_corrupted",
    "watch_card_not_found",
    "duplicate_card",
    "restore_available",
    "invalid_toss_credentials",
    "toss_connection_failed"
  ]
}
