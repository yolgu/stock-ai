  "outcomeDefinitions": {
    "common": {
      "observationProtocol": "protocol.outcomeObservation"
    },
    "eligibilityRules": {
      "profitTakingLike": "(C_t / C_{t-20} - 1) >= 2 * (ATR14_t / C_t)",
      "reliefAfterSelloff": "(max(C_{t-5:t-1}) - C_t) >= 1.5 * ATR14_t"
    },
    "reliefState": {
      "informationSet": "fixed at close_t before any future outcome observation",
      "selloffReferenceHigh": {
        "formula": "max(C_{t-5:t-1})",
        "inputs": [
          "C_{t-5:t-1}"
        ],
        "unit": "price"
      },
      "episodeLow": {
        "symbol": "episodeLow_t",
        "formula": "min(L_{t-5:t})",
        "inputs": [
          "L_{t-5:t}"
        ],
        "unit": "price",
        "futureRevisionAllowed": false
      },
      "midpointRecovery": {
        "symbol": "midpointRecovery_t",
        "formula": "episodeLow_t + 0.5 * (selloffReferenceHigh_t - episodeLow_t)",
        "inputs": [
          "episodeLow_t",
          "selloffReferenceHigh_t"
        ],
        "unit": "price",
        "futureRevisionAllowed": false
      }
    },
    "fomoContinuation": {
      "target": {
        "direction": "upper",
        "atrMultiple": 0.5
      },
      "opposite": {
        "direction": "lower",
        "atrMultiple": 0.3
      }
    },
    "fomoExhaustion": {
      "target": {
        "direction": "lower",
        "atrMultiple": 0.5
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.5
      }
    },
    "profitTakingLike": {
      "eligibilityRuleId": "profitTakingLike",
      "target": {
        "direction": "lower",
        "atrMultiple": 0.75
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.75
      }
    },
    "panicOnset": {
      "target": {
        "direction": "lower",
        "atrMultiple": 1.5
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.75
      }
    },
    "panicContinuation": {
      "target": {
        "direction": "lower",
        "atrMultiple": 0.75
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.5
      }
    },
    "reliefFirstRebound": {
      "eligibilityRuleId": "reliefAfterSelloff",
      "observationWindow": "t+1..t+h inclusive",
      "firstPassageRule": "upper target before lower opposite; common same-session dual-hit and right-censoring rules apply",
      "target": {
        "direction": "upper",
        "atrMultiple": 0.75,
        "barrierFormula": "C_t + 0.75 * ATR14_t"
      },
      "opposite": {
        "direction": "lower",
        "atrMultiple": 0.5,
        "barrierFormula": "C_t - 0.5 * ATR14_t"
      }
    },
    "reliefConfirmed": {
      "eligibilityRuleId": "reliefAfterSelloff",
      "baseOutcomeDefinitionId": "reliefFirstRebound",
      "baseFirstPassageWindow": "t+1..t+h-2 inclusive",
      "baseTargetDeadline": "t+h-2",
      "baseTargetHitSessionSymbol": "tau",
      "confirmation": {
        "sessions": 2,
        "observationSessions": [
          "tau+1",
          "tau+2"
        ],
        "lowCondition": "L_s >= episodeLow_t for each confirmation session s",
        "closeCondition": "C_s >= midpointRecovery_t for each confirmation session s",
        "successRule": "base upper barrier is first hit at tau and both confirmation sessions satisfy both conditions",
        "failureRule": "base rebound fails, or either confirmation session violates either condition"
      },
      "applicableHorizons": [
        3,
        5,
        10
      ]
    },
    "fakeRelief": {
      "requiresOutcomeDefinitionId": "reliefFirstRebound",
      "applicableHorizons": [
        3,
        5,
        10
      ],
      "baseFirstPassageWindow": "t+1..t+h-1 inclusive",
      "baseTargetHitSessionSymbol": "tau",
      "observationWindow": "tau+1..min(tau+3,t+h) inclusive",
      "target": {
        "event": "episodeLow_break",
        "formula": "L_s < episodeLow_t"
      },
      "competingTerminalEvent": {
        "event": "relief_confirmation",
        "formula": "the first completion of two consecutive sessions with L_s >= episodeLow_t and C_s >= midpointRecovery_t"
      },
      "firstPassageRule": "success when episodeLow_break occurs before relief_confirmation; failure when relief_confirmation occurs first or no episodeLow_break occurs by the observation-window end",
      "sameSessionRule": "episodeLow_break takes precedence because L_s < episodeLow_t makes relief_confirmation false",
      "requiresAtLeastOnePostReboundSession": true
    }
  },
  "featureDefinitions": {
    "common": {
      "returnDefinition": "r_j = log(C_j / C_{j-1})",
      "informationSet": "adjusted daily OHLCV through close_t only; no t+1 or later value is permitted",
      "zeroDenominator": "missing",
      "insufficientLookback": "missing",
      "zeroImputationAllowed": false
    },
    "atr14": {
      "formula": "mean(TR_{t-13:t})",
      "includesSignalSession": true
    },
    "rv20": {
      "formula": "std(r_{t-20:t-1})"
    },
    "highPrev20": {
      "formula": "max(H_{t-20:t-1})"
    },
    "lowPrev20": {
      "formula": "min(L_{t-20:t-1})"
    },
    "momentum5": {
      "formula": "log(C_t / C_{t-5})",
      "inputs": [
        "C_t",
        "C_{t-5}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_log_return",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "volume20": {
      "equivalentTo": "volumeSurprise",
      "rawFormula": "V_t / median(V_{t-20:t-1})",
      "inputs": [
        "V_t",
        "V_{t-20:t-1}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_volume_ratio",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "breakout20": {
      "formula": "clip((C_t - highPrev20_t) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "highPrev20_t",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "drawdown3": {
      "equivalentTo": "downMoveImpulse",
      "rawFormula": "max(-log(C_t / C_{t-3}), 0) / (RV20_t * sqrt(3))",
      "inputs": [
        "C_t",
        "C_{t-3}",
        "RV20_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_volatility_scaled_return",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "lowBreak20": {
      "formula": "clip((lowPrev20_t - C_t) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "lowPrev20_t",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "runup20": {
      "formula": "clip((C_t / C_{t-20} - 1) / (2 * ATR14_t / C_t), 0, 1)",
      "inputs": [
        "C_t",
        "C_{t-20}",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_two_atr_runup_ratio",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "returnImpulse": {
      "formula": "max(log(C_t / C_{t-5}), 0) / (RV20_t * sqrt(5))",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "returnAccel": {
      "formula": "max(r_t - mean(r_{t-5:t-1}), 0) / RV20_t",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "volumeSurprise": {
      "rawFormula": "V_t / median(V_{t-20:t-1})",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "rangeChase": {
      "formula": "0.6 * clip((C_t - lowPrev20_t) / (highPrev20_t - lowPrev20_t), 0, 1) + 0.4 * clip((C_t - highPrev20_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "typicalPrice": {
      "symbol": "TP_t",
      "formula": "(H_t + L_t + C_t) / 3"
    },
    "vwap20": {
      "formula": "sum_{j=t-19}^{t}(TP_j * V_j) / sum_{j=t-19}^{t}(V_j)"
    },
    "vwapPersistenceProxy": {
      "formula": "sum_{j=t-4}^{t}(V_j * I(TP_j > VWAP20_j)) / sum_{j=t-4}^{t}(V_j)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "pullbackHold": {
      "formula": "1 - clip((highPrev20_t - C_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "downMoveImpulse": {
      "formula": "max(-log(C_t / C_{t-3}), 0) / (RV20_t * sqrt(3))",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "vwapDownPressure": {
      "formula": "0.5 * clip((VWAP20_t - C_t) / ATR14_t, 0, 1) + 0.5 * (sum_{j=t-4}^{t}(V_j * I(TP_j < VWAP20_j)) / sum_{j=t-4}^{t}(V_j))",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "newLowCount5": {
      "formula": "sum_{j=t-4}^{t}(I(L_j < lowPrev20_j))"
    },
    "breakdownCascade": {
      "formula": "0.6 * clip((lowPrev20_t - C_t) / ATR14_t, 0, 1) + 0.4 * percentile(newLowCount5_t)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "liquidityProxy": {
      "rawFormula": "abs(r_t) / (C_t * V_t)",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "potentialPtpProxy": {
      "windowSessions": 120,
      "volumeWeight": "raw"
    },
    "profitBreadth": {
      "formula": "sum_{j=t-119}^{t}(V_j * I(TP_j < C_t)) / sum_{j=t-119}^{t}(V_j)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "profitGainMass": {
      "formula": "clip(sum_{j=t-119}^{t}(V_j * max(C_t - TP_j, 0)) / (sum_{j=t-119}^{t}(V_j) * ATR14_t), 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "vwapExtension": {
      "formula": "clip((C_t - VWAP20_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "rebound": {
      "formula": "clip((C_t - min(L_{t-4:t})) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "L_{t-4:t}",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "persistence": {
      "formula": "I(C_t > C_{t-1} and C_{t-1} > C_{t-2})",
      "inputs": [
        "C_t",
        "C_{t-1}",
        "C_{t-2}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "binary_indicator",
      "rawRange": [
        0,
        1
      ],
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "noNewLow": {
      "formula": "I(L_t >= L_{t-1})",
      "inputs": [
        "L_t",
        "L_{t-1}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "binary_indicator",
      "rawRange": [
        0,
        1
      ],
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "single_session_rebound": {
      "lowerWickFormula": "(C_t - L_t) / (H_t - L_t)",
      "lowerWickMissingWhen": "H_t = L_t",
      "reboundFeatureDefinitionId": "rebound",
      "formula": "0.5 * lowerWick_t + 0.5 * rebound_t",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "two_session_persistence_and_no_new_low": {
      "originalFeatureDefinitionId": "single_session_rebound",
      "gateFeatureDefinitionIds": [
        "persistence",
        "noNewLow"
      ],
      "gateFormula": "persistence_t * noNewLow_t",
      "formula": "single_session_rebound_t * persistence_t * noNewLow_t",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    }
  },
