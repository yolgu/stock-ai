    "outcomeObservation": {
      "signalTime": "close_t",
      "futureWindow": {
        "start": "t+1",
        "end": "t+h",
        "inclusive": true
      },
      "reference": {
        "close": "C_t",
        "atr": "ATR14_t"
      },
      "firstPassage": {
        "source": "future_OHLC",
        "sameSessionDualHit": "ambiguous_excluded",
        "neitherHit": "failure"
      },
      "rightCensoring": {
        "tail": "last_h",
        "disposition": "right_censored_excluded"
      }
    },
    "percentile": {
      "method": "midrank",
      "formula": "(count_less + 0.5 * count_equal) / n",
      "referenceWindow": {
        "direction": "prior_only",
        "maxSessions": 252,
        "minSessions": 60,
        "includesSignalSession": false
      }
    },
    "candidateScoring": {
      "informationSet": "daily adjusted OHLCV available through close_t only",
      "componentDomain": [
        0,
        1
      ],
      "compositeFormula": "score_t = 100 * sum_i(w_i * x_{i,t})",
      "weightConstraint": {
        "formula": "sum_i(w_i) = 1",
        "numericTolerance": 1e-12
      },
      "scoreRange": [
        0,
        100
      ],
      "baselineAndProxyFormula": "score_t = 100 * x_t",
      "missingComponent": {
        "scoreDisposition": "unavailable",
        "reweightAllowed": false
      }
    },
    "probabilityCalibration": {
      "purpose": "convert an ordinal risk score into an out-of-sample event probability without treating score/100 as a probability",
      "scoreDirection": "higher_score_means_non_decreasing_event_probability",
      "fitUnit": "fold_x_candidate_x_outcome_x_horizon",
      "trainingPairs": {
        "requiredFields": [
          "finite_score",
          "binary_outcome_label"
        ],
        "source": "current fold training partition only",
        "minimumValidPairs": 30,
        "eventWeightsUsedForFit": false,
        "missingPairDisposition": "excluded_from_calibration_fit",
        "insufficientPairDisposition": "calibrator_and_test_probabilities_unavailable"
      },
      "quantileBins": {
        "binCount": 5,
        "internalQuantiles": [
          0.2,
          0.4,
          0.6,
          0.8
        ],
        "edgeAlgorithm": "for q=k/5, use the score at one-based order statistic ceil(q*n) after ascending score sort",
        "binIntervals": "(-infinity,e1],(e1,e2],...,(em,infinity)",
        "tiedScoreRule": "equal scores are never split across bins",
        "duplicateEdgeRule": "collapse equal adjacent quantile edges before assigning bins",
        "emptyBinRule": "drop empty bins after edge collapse"
      },
      "binProbability": {
        "prior": "Jeffreys Beta(0.5,0.5)",
        "formula": "p_j = (s_j + 0.5) / (n_j + 1)",
        "successCount": "unweighted count of label=1 in bin j",
        "sampleCount": "unweighted count of valid training pairs in bin j"
      },
      "monotonicFit": {
        "algorithm": "pool_adjacent_violators",
        "direction": "non_decreasing_by_score_bin",
        "initialValue": "binProbability.p_j",
        "weight": "n_j",
        "violationRule": "while a left fitted value is greater than its right neighbor, replace the adjacent violating blocks by their n-weighted mean and repeat until no violation remains"
      },
      "testApplication": {
        "probabilitySource": "fitted monotonic bin value from the corresponding training-only calibrator",
        "belowTrainingMinimum": "first non-empty fitted bin",
        "aboveTrainingMaximum": "last non-empty fitted bin",
        "missingScore": "probability_unavailable",
        "testLabelsUsedForFit": false,
        "retrainingOnTest": false
      },
      "replicationAndHoldout": {
        "finalCalibratorFit": "after TSLA candidate selection, fit once using valid pairs from the TSLA candidate-selection window only",
        "frozenApplicationSymbols": [
          "NVDA",
          "MU",
          "000660"
        ],
        "replicationOrHoldoutLabelsUsedForFit": false,
        "retrainingOrUpdatingAllowed": false
      },
      "trainBaseRateComparator": {
        "fitUnit": "fold_x_outcome_x_horizon",
        "trainingLabels": "all finite binary labels in the fold training partition; candidate score availability is not required",
        "minimumValidLabels": 30,
        "formula": "p_base = (s_train + 0.5) / (n_train + 1)",
        "prior": "Jeffreys Beta(0.5,0.5)",
        "application": "constant probability for every observation in that fold test partition",
        "replicationAndHoldout": "freeze the TSLA candidate-selection-window Jeffreys base rate; do not refit"
      }
    },
    "threshold": {
      "fit": "train_only",
      "quantile": 0.8,
      "input": "raw candidate score",
      "purpose": "alert classification only",
      "probabilityCalibrationIndependent": true
    },
    "walkForward": {
      "method": "expanding",
      "trainingData": "past_only",
      "purge": {
        "sessions": 10,
        "placement": "training_tail_before_test"
      },
      "embargo": {
        "sessions": 10,
        "placement": "after_test_before_next_train"
      },
      "testTuningAllowed": false
    },
    "episodes": {
      "ordering": "chronological",
      "start": "first_signal_crossing",
      "newEventSuppression": "through_t_plus_h_inclusive",
      "labels": "shared_across_candidates"
    },
    "marketEventClustering": {
      "direction": "same",
      "targetDateToleranceCalendarDays": 1,
      "globalEventWeight": "1/clusterSize",
      "symbolMetricsRetainEvents": true
    },
    "trialApplicability": {
      "combination": "intersection",
      "formula": "effectiveHorizons(candidate,outcome) = candidate.applicableHorizons intersect candidate.outcomeApplicableHorizons[outcome] intersect outcomeDefinition.applicableHorizons",
      "missingOutcomeSpecificCandidateSet": "use candidate.applicableHorizons as the candidate outcome-specific set",
      "missingOutcomeDefinitionSet": "use protocol.horizons as the outcome-definition set",
      "outcomeMembershipRule": "an outcome is considered only when its id is present in candidate.outcomeDefinitionIds",
      "candidateTrialRule": "candidate@h is applicable when at least one declared outcome has h in its effectiveHorizons",
      "fixedReliefCases": {
        "relief.originalProxy@1": {
          "applicable": true,
          "generatedOutcomes": [
