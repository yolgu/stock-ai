          "excludedOutcomes": [
            "reliefConfirmed",
            "fakeRelief"
          ]
        }
      },
      "applicableFalseDisposition": {
        "prediction": "not_generated",
        "metrics": "excluded",
        "minimumEventCount": "excluded_from_numerator_denominator_and_pass_fail",
        "multipleTesting": "excluded_from_hypothesis_family_and_adjustment_count"
      }
    },
    "phases": {
      "prodrome": "t-5..t-1",
      "start": "t",
      "early": "start_to_half_barrier",
      "middle": "half_barrier_to_full_barrier",
      "extreme": "full_barrier_hit",
      "firstRebound": {
        "direction": "opposite",
        "closeMoveMinimumAtr": 0.25
      },
      "confirmation": {
        "consecutiveCloses": 2,
        "newExtremeAllowed": false
      },
      "end": "confirmation_or_vertical_barrier"
    },
    "minimumEvents": {
      "count": 30,
      "unit": "candidate_x_outcome_x_symbol_x_split"
    },
    "bootstrap": {
      "method": "moving_block",
      "blockLengths": [
        5,
        10,
        20
      ],
      "repetitions": 2000,
      "seed": 20260710,
      "confidenceInterval": {
        "method": "percentile",
        "lowerQuantile": 0.025,
        "upperQuantile": 0.975
      },
      "metrics": [
        "BrierDifference",
        "PR-AUC",
        "MCC",
        "leadTime"
      ]
    },
    "posterior": {
      "prior": "Jeffreys",
      "distribution": "Beta",
      "alpha": 0.5,
      "beta": 0.5
    },
    "significance": {
      "alpha": 0.05,
      "secondary": {
        "method": "BH",
        "scope": "within_family_x_horizon"
      },
      "primaryConclusions": {
        "method": "Holm",
        "scope": "across_primary_family_conclusions"
      }
    }
  },
  "outcomeDefinitions": {
    "common": {
      "observationProtocol": "protocol.outcomeObservation"
    },
    "eligibilityRules": {
      "profitTakingLike": "(C_t / C_{t-20} - 1) >= 2 * (ATR14_t / C_t)",
      "reliefAfterSelloff": "(max(C_{t-5:t-1}) - C_t) >= 1.5 * ATR14_t"
    },
    "reliefState": {
      "informationSet": "fixed at close_t before any future outcome observation",
      "selloffReferenceHigh": {
        "formula": "max(C_{t-5:t-1})",
        "inputs": [
          "C_{t-5:t-1}"
        ],
        "unit": "price"
      },
      "episodeLow": {
        "symbol": "episodeLow_t",
        "formula": "min(L_{t-5:t})",
        "inputs": [
          "L_{t-5:t}"
        ],
        "unit": "price",
        "futureRevisionAllowed": false
      },
      "midpointRecovery": {
        "symbol": "midpointRecovery_t",
        "formula": "episodeLow_t + 0.5 * (selloffReferenceHigh_t - episodeLow_t)",
        "inputs": [
          "episodeLow_t",
          "selloffReferenceHigh_t"
        ],
        "unit": "price",
        "futureRevisionAllowed": false
      }
    },
    "fomoContinuation": {
      "target": {
        "direction": "upper",
        "atrMultiple": 0.5
      },
      "opposite": {
        "direction": "lower",
        "atrMultiple": 0.3
      }
    },
    "fomoExhaustion": {
      "target": {
        "direction": "lower",
        "atrMultiple": 0.5
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.5
      }
    },
    "profitTakingLike": {
      "eligibilityRuleId": "profitTakingLike",
      "target": {
        "direction": "lower",
        "atrMultiple": 0.75
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.75
      }
    },
    "panicOnset": {
      "target": {
        "direction": "lower",
        "atrMultiple": 1.5
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.75
      }
    },
    "panicContinuation": {
      "target": {
        "direction": "lower",
        "atrMultiple": 0.75
      },
      "opposite": {
        "direction": "upper",
        "atrMultiple": 0.5
      }
    },
    "reliefFirstRebound": {
      "eligibilityRuleId": "reliefAfterSelloff",
      "observationWindow": "t+1..t+h inclusive",
      "firstPassageRule": "upper target before lower opposite; common same-session dual-hit and right-censoring rules apply",
      "target": {
        "direction": "upper",
        "atrMultiple": 0.75,
        "barrierFormula": "C_t + 0.75 * ATR14_t"
      },
      "opposite": {
        "direction": "lower",
        "atrMultiple": 0.5,
        "barrierFormula": "C_t - 0.5 * ATR14_t"
      }
    },
    "reliefConfirmed": {
      "eligibilityRuleId": "reliefAfterSelloff",
      "baseOutcomeDefinitionId": "reliefFirstRebound",
      "baseFirstPassageWindow": "t+1..t+h-2 inclusive",
      "baseTargetDeadline": "t+h-2",
      "baseTargetHitSessionSymbol": "tau",
      "confirmation": {
        "sessions": 2,
        "observationSessions": [
          "tau+1",
          "tau+2"
        ],
        "lowCondition": "L_s >= episodeLow_t for each confirmation session s",
        "closeCondition": "C_s >= midpointRecovery_t for each confirmation session s",
        "successRule": "base upper barrier is first hit at tau and both confirmation sessions satisfy both conditions",
        "failureRule": "base rebound fails, or either confirmation session violates either condition"
      },
      "applicableHorizons": [
        3,
        5,
        10
      ]
    },
    "fakeRelief": {
      "requiresOutcomeDefinitionId": "reliefFirstRebound",
      "applicableHorizons": [
        3,
        5,
        10
      ],
      "baseFirstPassageWindow": "t+1..t+h-1 inclusive",
      "baseTargetHitSessionSymbol": "tau",
      "observationWindow": "tau+1..min(tau+3,t+h) inclusive",
      "target": {
        "event": "episodeLow_break",
        "formula": "L_s < episodeLow_t"
      },
      "competingTerminalEvent": {
        "event": "relief_confirmation",
        "formula": "the first completion of two consecutive sessions with L_s >= episodeLow_t and C_s >= midpointRecovery_t"
      },
      "firstPassageRule": "success when episodeLow_break occurs before relief_confirmation; failure when relief_confirmation occurs first or no episodeLow_break occurs by the observation-window end",
      "sameSessionRule": "episodeLow_break takes precedence because L_s < episodeLow_t makes relief_confirmation false",
      "requiresAtLeastOnePostReboundSession": true
    }
  },
  "featureDefinitions": {
    "common": {
      "returnDefinition": "r_j = log(C_j / C_{j-1})",
      "informationSet": "adjusted daily OHLCV through close_t only; no t+1 or later value is permitted",
      "sessionIndexing": "all endpoints refer to ordered actual trading-session observations and are inclusive; no calendar-day interpolation",
      "rollingValidity": "every observation required by a window must be finite and valid; partial-window calculation and synthetic filling are prohibited",
      "medianDefinition": "for an even sample count, median is the arithmetic mean of the two central values after ascending sort",
      "rollingWindows": {
        "atr14": {
          "endpoints": "TR_{t-13:t}",
          "minimumPeriods": "14 valid true-range observations requiring OHLC_{t-13:t} and C_{t-14}"
        },
        "rv20": {
          "endpoints": "r_{t-20:t-1}",
          "minimumPeriods": "20 valid returns requiring C_{t-21:t-1}"
        },
        "previous20Extrema": {
          "endpoints": "H_{t-20:t-1} or L_{t-20:t-1}",
          "minimumPeriods": 20
        },
        "momentumAndReturnImpulse5": {
          "endpoints": "C_{t-5} and C_t",
          "minimumPeriods": "6 valid close observations from t-5 through t"
        },
        "returnAcceleration5": {
          "endpoints": "r_t and r_{t-5:t-1}",
          "minimumPeriods": "6 valid returns including r_t"
        },
        "drawdown3": {
          "endpoints": "C_{t-3} and C_t",
          "minimumPeriods": "4 valid close observations from t-3 through t"
        },
        "runup20": {
          "endpoints": "C_{t-20} and C_t",
          "minimumPeriods": "21 valid close observations from t-20 through t"
        },
        "profitTakingEligibility20": {
          "endpoints": "C_{t-20}, C_t, and ATR14_t",
          "minimumPeriods": "21 valid close observations plus a valid ATR14_t"
        },
        "volumeReference20": {
          "endpoints": "V_{t-20:t-1} plus V_t",
          "minimumPeriods": "20 valid reference volumes plus current volume"
        },
        "vwap20": {
          "endpoints": "TP_j and V_j for j=t-19..t",
          "minimumPeriods": 20
        },
        "vwapPersistence5": {
          "endpoints": "j=t-4..t",
          "minimumPeriods": "5 valid TP_j, V_j, and VWAP20_j observations"
        },
        "newLowCount5": {
          "endpoints": "j=t-4..t",
          "minimumPeriods": "5 valid L_j and lowPrev20_j observations"
        },
        "profitMass120": {
          "endpoints": "j=t-119..t",
          "minimumPeriods": 120
        },
        "rebound5": {
          "endpoints": "L_{t-4:t} plus C_t",
          "minimumPeriods": 5
        },
        "persistence3": {
          "endpoints": "C_{t-2:t}",
          "minimumPeriods": 3
        },
        "noNewLow2": {
          "endpoints": "L_{t-1:t}",
          "minimumPeriods": 2
        },
        "reliefSelloff6": {
          "endpoints": "C_{t-5:t} and L_{t-5:t}",
          "minimumPeriods": 6
        },
        "percentileTransform": {
          "endpoints": "up to 252 sessions strictly before t",
          "minimumPeriods": 60,
          "maximumPeriods": 252
        }
      },
      "volumeZeroSemantics": {
        "observedZero": "V_j=0 is a valid observed volume and counts toward minimumPeriods",
        "weightedTerm": "a zero-volume observation contributes zero numerator weight",
        "ratioNumerator": "V_t=0 produces raw volume ratio 0 only when its reference median is positive",
        "zeroMedian": "median(V_reference)=0 makes the volume-ratio feature missing",
        "zeroSum": "sum(V_window)=0 makes every volume-weighted ratio or VWAP using that denominator missing",
        "liquidityProxy": "V_t=0 makes abs(r_t)/(C_t*V_t) missing"
      },
      "zeroDenominator": "missing",
      "insufficientLookback": "missing",
      "zeroImputationAllowed": false
    },
    "trueRange": {
      "symbol": "TR_t",
      "formula": "max(H_t - L_t, abs(H_t - C_{t-1}), abs(L_t - C_{t-1}))",
      "inputs": [
        "H_t",
        "L_t",
        "C_{t-1}"
      ],
      "unit": "price",
      "range": [
        0,
        "infinity"
      ]
    },
    "atr14": {
      "formula": "sum_{j=t-13}^{t}(TR_j) / 14",
      "aggregation": "arithmetic_mean",
      "windowEndpoints": "TR_{t-13:t} inclusive",
      "minimumPeriods": 14,
      "includesSignalSession": true,
      "unit": "price",
      "range": [
        0,
        "infinity"
      ]
    },
    "rv20": {
      "formula": "sqrt(sum_{j=t-20}^{t-1}((r_j - mean(r_{t-20:t-1}))^2) / 20)",
      "aggregation": "population_standard_deviation",
      "ddof": 0,
      "windowEndpoints": "r_{t-20:t-1} inclusive",
      "minimumPeriods": 20,
      "includesSignalSessionReturn": false,
      "unit": "dimensionless_log_return_volatility",
      "range": [
        0,
        "infinity"
      ]
    },
    "highPrev20": {
      "formula": "max(H_{t-20:t-1})",
      "windowEndpoints": "H_{t-20:t-1} inclusive",
      "minimumPeriods": 20
    },
    "lowPrev20": {
      "formula": "min(L_{t-20:t-1})",
      "windowEndpoints": "L_{t-20:t-1} inclusive",
      "minimumPeriods": 20
    },
    "momentum5": {
      "formula": "log(C_t / C_{t-5})",
      "inputs": [
        "C_t",
        "C_{t-5}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_log_return",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "volume20": {
      "equivalentTo": "volumeSurprise",
      "rawFormula": "V_t / median(V_{t-20:t-1})",
      "inputs": [
        "V_t",
        "V_{t-20:t-1}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_volume_ratio",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "breakout20": {
      "formula": "clip((C_t - highPrev20_t) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "highPrev20_t",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "drawdown3": {
      "equivalentTo": "downMoveImpulse",
      "rawFormula": "max(-log(C_t / C_{t-3}), 0) / (RV20_t * sqrt(3))",
      "inputs": [
        "C_t",
        "C_{t-3}",
        "RV20_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_volatility_scaled_return",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "lowBreak20": {
      "formula": "clip((lowPrev20_t - C_t) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "lowPrev20_t",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "runup20": {
      "formula": "clip((C_t / C_{t-20} - 1) / (2 * ATR14_t / C_t), 0, 1)",
      "inputs": [
        "C_t",
        "C_{t-20}",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_two_atr_runup_ratio",
      "rawRange": [
        "-infinity",
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "returnImpulse": {
      "formula": "max(log(C_t / C_{t-5}), 0) / (RV20_t * sqrt(5))",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "returnAccel": {
      "formula": "max(r_t - mean(r_{t-5:t-1}), 0) / RV20_t",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "volumeSurprise": {
      "rawFormula": "V_t / median(V_{t-20:t-1})",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "rangeChase": {
      "formula": "0.6 * clip((C_t - lowPrev20_t) / (highPrev20_t - lowPrev20_t), 0, 1) + 0.4 * clip((C_t - highPrev20_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "typicalPrice": {
      "symbol": "TP_t",
      "formula": "(H_t + L_t + C_t) / 3"
    },
    "vwap20": {
      "formula": "sum_{j=t-19}^{t}(TP_j * V_j) / sum_{j=t-19}^{t}(V_j)"
    },
    "vwapPersistenceProxy": {
      "formula": "sum_{j=t-4}^{t}(V_j * I(TP_j > VWAP20_j)) / sum_{j=t-4}^{t}(V_j)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "pullbackHold": {
      "formula": "1 - clip((highPrev20_t - C_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "downMoveImpulse": {
      "formula": "max(-log(C_t / C_{t-3}), 0) / (RV20_t * sqrt(3))",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "vwapDownPressure": {
      "formula": "0.5 * clip((VWAP20_t - C_t) / ATR14_t, 0, 1) + 0.5 * (sum_{j=t-4}^{t}(V_j * I(TP_j < VWAP20_j)) / sum_{j=t-4}^{t}(V_j))",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "newLowCount5": {
      "formula": "sum_{j=t-4}^{t}(I(L_j < lowPrev20_j))"
    },
    "breakdownCascade": {
      "formula": "0.6 * clip((lowPrev20_t - C_t) / ATR14_t, 0, 1) + 0.4 * percentile(newLowCount5_t)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "liquidityProxy": {
      "rawFormula": "abs(r_t) / (C_t * V_t)",
      "transform": "protocol.percentile",
      "range": [
        0,
        1
      ]
    },
    "potentialPtpProxy": {
      "windowSessions": 120,
      "volumeWeight": "raw"
    },
    "profitBreadth": {
      "formula": "sum_{j=t-119}^{t}(V_j * I(TP_j < C_t)) / sum_{j=t-119}^{t}(V_j)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "profitGainMass": {
      "formula": "clip(sum_{j=t-119}^{t}(V_j * max(C_t - TP_j, 0)) / (sum_{j=t-119}^{t}(V_j) * ATR14_t), 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "vwapExtension": {
      "formula": "clip((C_t - VWAP20_t) / ATR14_t, 0, 1)",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "rebound": {
      "formula": "clip((C_t - min(L_{t-4:t})) / ATR14_t, 0, 1)",
      "inputs": [
        "C_t",
        "L_{t-4:t}",
        "ATR14_t"
      ],
      "inputAvailability": "through_close_t",
      "unit": "dimensionless_atr_multiple",
      "rawRange": [
        0,
        "infinity"
      ],
      "transform": "clip_0_1",
      "range": [
        0,
        1
      ]
    },
    "persistence": {
      "formula": "I(C_t > C_{t-1} and C_{t-1} > C_{t-2})",
      "inputs": [
        "C_t",
        "C_{t-1}",
        "C_{t-2}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "binary_indicator",
      "rawRange": [
        0,
        1
      ],
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "noNewLow": {
      "formula": "I(L_t >= L_{t-1})",
      "inputs": [
        "L_t",
        "L_{t-1}"
      ],
      "inputAvailability": "through_close_t",
      "unit": "binary_indicator",
      "rawRange": [
        0,
        1
      ],
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "single_session_rebound": {
      "lowerWickFormula": "(C_t - L_t) / (H_t - L_t)",
      "lowerWickMissingWhen": "H_t = L_t",
      "reboundFeatureDefinitionId": "rebound",
      "formula": "0.5 * lowerWick_t + 0.5 * rebound_t",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    },
    "two_session_persistence_and_no_new_low": {
      "originalFeatureDefinitionId": "single_session_rebound",
      "gateFeatureDefinitionIds": [
        "persistence",
        "noNewLow"
      ],
      "gateFormula": "persistence_t * noNewLow_t",
      "formula": "single_session_rebound_t * persistence_t * noNewLow_t",
      "transform": "identity",
      "range": [
        0,
        1
      ]
    }
  },
